                "    #\"Consultas Mescladas4\" = Table.NestedJoin(#\"DimConteudista Expandido\", {\"uf_pessoa\", \"municipio_pessoa\"}, DimEndereco, {\"uf_pessoa\", \"municipio_pessoa\"}, \"DimEndereco\", JoinKind.LeftOuter),",
                "    #\"DimEndereco Expandido\" = Table.ExpandTableColumn(#\"Consultas Mescladas4\", \"DimEndereco\", {\"cod_endereco\"}, {\"cod_endereco\"}),",
                "    #\"Consultas Mescladas5\" = Table.NestedJoin(#\"DimEndereco Expandido\", {\"tematica\"}, DimTematica, {\"tematica\"}, \"DimTematica\", JoinKind.LeftOuter),",
                "    #\"DimTematica Expandido\" = Table.ExpandTableColumn(#\"Consultas Mescladas5\", \"DimTematica\", {\"cod_tematica\"}, {\"cod_tematica\"}),",
                "    #\"Colunas Removidas\" = Table.RemoveColumns(#\"DimTematica Expandido\",{\"email_conteudista\", \"telefone_pessoa\", \"email_pessoa\", \"esfera\", \"poder\", \"idade\", \"sexo\", \"tematica\", \"conteudista\", \"municipio_pessoa\", \"instituicao\", \"uf_pessoa\", \"nome_curso\", \"carga_horaria\"}),",
                "    #\"Colunas Reordenadas\" = Table.ReorderColumns(#\"Colunas Removidas\",{\"cod_matricula\", \"codigo_pessoa\", \"cod_poder\", \"cod_esfera\", \"cod_instituicao\", \"cod_conteudista\", \"cod_endereco\", \"cod_tematica\", \"dt_matricula\", \"nacionalidade\", \"cod_turma\", \"nome_turma\", \"modalidade_turma\", \"cod_curso\", \"dt_fim\", \"sit_turma\", \"sit_matricula\"}),",
