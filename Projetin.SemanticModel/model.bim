              "expression": [
                "let",
                "    Fonte = Csv.Document(File.Contents(\"C:\\Users\\caua.godoy\\Downloads\\sample_evg_enriquecido.csv\"),[Delimiter=\",\", Columns=25, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    #\"Cabeçalhos Promovidos\" = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    #\"Tipo Alterado\" = Table.TransformColumnTypes(#\"Cabeçalhos Promovidos\",{{\"cod_matricula\", type text}, {\"dt_matricula\", type datetime}, {\"nacionalidade\", type text}, {\"cod_turma\", Int64.Type}, {\"nome_turma\", type text}, {\"modalidade_turma\", type text}, {\"cod_curso\", Int64.Type}, {\"nome_curso\", type text}, {\"carga_horaria\", Int64.Type}, {\"dt_fim\", type datetime}, {\"sit_turma\", type text}, {\"instituicao\", type text}, {\"municipio_pessoa\", type text}, {\"uf_pessoa\", type text}, {\"conteudista\", type text}, {\"tematica\", type text}, {\"codigo_pessoa\", type text}, {\"sexo\", type text}, {\"idade\", Int64.Type}, {\"sit_matricula\", type text}, {\"poder\", type text}, {\"esfera\", type text}, {\"email_pessoa\", type text}, {\"telefone_pessoa\", Int64.Type}, {\"email_conteudista\", type text}}),",
                "    #\"Consultas Mescladas\" = Table.NestedJoin(#\"Tipo Alterado\", {\"poder\"}, DimPoder, {\"poder\"}, \"DimPoder\", JoinKind.LeftOuter),",
                "    #\"DimPoder Expandido\" = Table.ExpandTableColumn(#\"Consultas Mescladas\", \"DimPoder\", {\"cod_poder\"}, {\"cod_poder\"}),",
                "    #\"Consultas Mescladas1\" = Table.NestedJoin(#\"DimPoder Expandido\", {\"esfera\"}, DimEsfera, {\"esfera\"}, \"DimEsfera\", JoinKind.LeftOuter),",
                "    #\"DimEsfera Expandido\" = Table.ExpandTableColumn(#\"Consultas Mescladas1\", \"DimEsfera\", {\"cod_esfera\"}, {\"cod_esfera\"}),",
                "    #\"Consultas Mescladas2\" = Table.NestedJoin(#\"DimEsfera Expandido\", {\"instituicao\"}, DimInstituicao, {\"instituicao\"}, \"DimInstituicao\", JoinKind.LeftOuter),",
                "    #\"DimInstituicao Expandido\" = Table.ExpandTableColumn(#\"Consultas Mescladas2\", \"DimInstituicao\", {\"cod_instituicao\"}, {\"cod_instituicao\"}),",
                "    #\"Consultas Mescladas3\" = Table.NestedJoin(#\"DimInstituicao Expandido\", {\"conteudista\"}, DimConteudista, {\"conteudista\"}, \"DimConteudista\", JoinKind.LeftOuter),",
