                "    #\"Colunas Reordenadas1\" = Table.ReorderColumns(#\"Colunas Removidas1\",{\"cod_matricula\", \"codigo_pessoa\", \"cod_poder\", \"cod_esfera\", \"cod_instituicao\", \"cod_conteudista\", \"cod_endereco\", \"cod_tematica\", \"cod_turma\", \"cod_curso\", \"dt_matricula\", \"dt_fim\", \"sit_turma\", \"sit_matricula\"})",
